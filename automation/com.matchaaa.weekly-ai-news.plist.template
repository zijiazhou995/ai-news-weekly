<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.matchaaa.weekly-ai-news</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-B</string>
    <string>/Users/matchaaa/Documents/ai新闻资讯/weekly_ai_news.py</string>
    <string>run</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/matchaaa/Documents/ai新闻资讯</string>

  <key>StartCalendarInterval</key>
