    <key>Weekday</key>
    <integer>4</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/matchaaa/Documents/ai新闻资讯/data/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/matchaaa/Documents/ai新闻资讯/data/launchd.err.log</string>
